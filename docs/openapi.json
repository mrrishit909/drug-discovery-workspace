 "components": {
  "schemas": {
   "AffinityIn": {
    "properties": {
     "compound_ids": {
      "items": {
       "type": "string",
       "format": "uuid"
      },
      "type": "array",
      "maxItems": 200,
      "title": "Compound Ids",
      "default": []
     },
     "smiles": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 50,
      "title": "Smiles",
      "default": []
     }
    },
    "type": "object",
    "title": "AffinityIn"
   },
   "BatchIn": {
    "properties": {
     "plate_size": {
      "type": "integer",
      "maximum": 384.0,
      "minimum": 8.0,
      "title": "Plate Size",
      "default": 96
     },
     "budget": {
      "type": "number",
      "maximum": 5000.0,
      "minimum": 8.0,
      "title": "Budget",
      "description": "Cost units: 1 for a compound in stock, 5 for one to be made",
      "default": 200
     },
     "kappa": {
      "type": "number",
      "maximum": 3.0,
      "minimum": 0.0,
      "title": "Kappa",
      "description": "Weight on uncertainty: 0 exploits, 2 explores",
      "default": 1.0
     },
     "max_similarity": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.3,
      "title": "Max Similarity",
      "default": 0.7
     }
    },
    "type": "object",
    "title": "BatchIn"
   },
   "CompoundsIn": {
    "properties": {
     "smiles": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 1000,
      "minItems": 1,
      "title": "Smiles"
     },
     "source": {
      "type": "string",
      "maxLength": 40,
      "title": "Source",
      "default": "upload"
     }
    },
    "type": "object",
    "required": [
     "smiles"
    ],
    "title": "CompoundsIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "MeasurementIn": {
    "properties": {
     "compound_id": {
      "type": "string",
      "format": "uuid",
      "title": "Compound Id"
     },
     "value": {
      "type": "number",
      "maximum": 12.0,
      "minimum": 3.0,
